      "widgets_values": [
        "llama-cpp",
        "Qwen3-VL-8B-Instruct-Q4_K_M.gguf",
        "mmproj-BF16.gguf",
        "{\"subjects\":[{\"name\":\"莱伦\",\"description\":\"男子\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"minimaxrefdirector/莱伦.png\",\"audioFile\":\"minimaxrefdirector/ComfyUI_temp_gfxck_00001.flac\",\"videoFile\":\"\"},{\"name\":\"琼娜\",\"description\":\"拥有一头黑色长卷发，左侧佩戴带有红色圆形符文和金属尖角的发饰。她肤色白皙，眼瞳呈现鲜红色，神情冷艳。穿着一件带有暗色藤蔓图案的暗红色宽松长款外袍，内搭黑色抹胸和黑色多层长裙，腰间系有红黑相间的腰带和挂坠。脖子上戴着几何形状的项链，双手戴黑色半指手套，脚穿黑色短靴。\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"minimaxrefdirector/琼娜.png\",\"audioFile\":\"minimaxrefdirector/琼娜-配音.mp3\",\"videoFile\":\"\"},{\"name\":\"怪兽\",\"description\":\"\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"minimaxrefdirector/动画剧情概述.png\",\"audioFile\":\"\",\"videoFile\":\"\"},{\"name\":\"参考视频\",\"description\":\"这是描述\",\"type\":\"Video\",\"relationship\":\"weak_reference\",\"imageFile\":\"\",\"audioFile\":\"\",\"videoFile\":\"minimaxrefdirector/MiniMax_H3_00020_.mp4\"},{\"name\":\"参考音频\",\"description\":\"\",\"type\":\"Audio\",\"relationship\":\"reference\",\"imageFile\":\"\",\"audioFile\":\"\",\"videoFile\":\"\"},{\"name\":\"森林背景\",\"description\":\"\",\"type\":\"Picture\",\"relationship\":\"fully_preserved\",\"imageFile\":\"minimaxrefdirector/树人.png\",\"audioFile\":\"\",\"videoFile\":\"\"},{\"name\":\"眼瞳1\",\"description\":\"\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"\",\"audioFile\":\"\",\"videoFile\":\"\"},{\"name\":\"眼瞳2\",\"description\":\"\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"\",\"audioFile\":\"\",\"videoFile\":\"\"},{\"name\":\"眼瞳3\",\"description\":\"\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"\",\"audioFile\":\"\",\"videoFile\":\"\"},{\"name\":\"眼瞳眼瞳\",\"description\":\"\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"\",\"audioFile\":\"\",\"videoFile\":\"\"},{\"name\":\"眼瞳眼瞳眼瞳\",\"description\":\"\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"\",\"audioFile\":\"\",\"videoFile\":\"\"},{\"name\":\"眼瞳眼瞳眼瞳眼瞳\",\"description\":\"\",\"type\":\"Subject\",\"relationship\":\"fully_preserved\",\"imageFile\":\"\",\"audioFile\":\"\",\"videoFile\":\"\"}]}",
